  "fixed_sql": [
    {
      "name": "daily_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_logs\" (\"date\" TEXT NOT NULL, \"is_period_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_period_day\" IN (0, 1)), \"flow\" TEXT NULL, \"mood\" TEXT NULL, \"notes\" TEXT NULL, \"period_day_explicit\" INTEGER NOT NULL DEFAULT 0 CHECK (\"period_day_explicit\" IN (0, 1)), \"period_end\" TEXT NULL CHECK(\"period_end\" IS NULL OR \"is_period_day\" = 1), PRIMARY KEY (\"date\"), CHECK ((flow IS NULL) OR (is_period_day = 1)));"
        }
      ]
    },
    {
      "name": "daily_log_symptoms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_log_symptoms\" (\"log_date\" TEXT NOT NULL, \"symptom\" TEXT NOT NULL, PRIMARY KEY (\"log_date\", \"symptom\"), FOREIGN KEY (log_date) REFERENCES daily_logs (date) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"onboarding_seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_seen\" IN (0, 1)), \"notifications_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"notifications_enabled\" IN (0, 1)), \"period_reminder_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"period_reminder_enabled\" IN (0, 1)), \"fertile_window_reminders_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"fertile_window_reminders_enabled\" IN (0, 1)), \"show_details_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_details_enabled\" IN (0, 1)), \"reminder_hour\" INTEGER NOT NULL DEFAULT 9, \"reminder_minute\" INTEGER NOT NULL DEFAULT 0, \"typical_period_length\" INTEGER NOT NULL DEFAULT 5 CHECK(\"typical_period_length\" BETWEEN 1 AND 15), \"show_fertile_window\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_fertile_window\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 0));"
        }
      ]
    }
  ]
